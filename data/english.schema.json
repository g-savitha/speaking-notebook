{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "English speaking log",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["date", "type", "original", "better"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d+$", "description": "Optional. <date>-<n>, unique in this file." },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Session date, YYYY-MM-DD." },
      "type": { "type": "string", "enum": ["phrase", "rephrasing", "diplomatic expression", "feedback"] },
      "original": { "type": "string", "minLength": 1, "description": "What she said." },
      "better": { "type": "string", "minLength": 1, "description": "Better version." },
      "notes": { "type": "string" }
    }
  }
}
