{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy log (Kanha)",
  "description": "Append with scripts/append.mjs, which fills id, status, seen, lastSeen and revisit. scenarioId is required for mode \"scenario\" and not allowed for \"debrief\"; pattern must be listed in data/patterns.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "mode",
      "situation",
      "whatIDid",
      "whatWentWrong",
      "betterMove",
      "principle",
      "pattern",
      "status",
      "seen",
      "lastSeen",
      "revisit"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^st-\\d{4}-\\d{2}-\\d{2}-\\d+$"
      },
      "date": {
        "$ref": "#/$defs/date"
      },
      "mode": {
        "type": "string",
        "enum": [
          "debrief",
          "scenario"
        ]
      },
      "scenarioId": {
        "type": "string",
        "pattern": "^S\\d{2,}$",
        "description": "Bank id from data/scenarios.json. Only for mode scenario."
      },
      "situation": {
        "type": "string",
        "minLength": 1,
        "description": "Roles only, no names (e.g. 'peer presented my work to the director')."
      },
      "whatIDid": {
        "type": "string",
        "minLength": 1
      },
      "whatWentWrong": {
        "type": "string",
        "minLength": 1
      },
      "betterMove": {
        "type": "string",
        "minLength": 1,
        "description": "Include the exact sentence to say next time."
      },
      "principle": {
        "type": "string",
        "minLength": 1,
        "description": "One plain sentence."
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "description": "Citation, e.g. '48 Laws of Power, Law 5'."
      },
      "pattern": {
        "type": "string",
        "minLength": 1,
        "description": "One of data/patterns.json."
      },
      "status": {
        "type": "string",
        "enum": [
          "new",
          "practicing",
          "mastered"
        ]
      },
      "seen": {
        "type": "integer",
        "minimum": 1,
        "description": "How many times this mistake has come up."
      },
      "lastSeen": {
        "$ref": "#/$defs/date"
      },
      "revisit": {
        "$ref": "#/$defs/revisit"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "revisit": {
      "type": "object",
      "required": [
        "due",
        "step"
      ],
      "additionalProperties": false,
      "properties": {
        "due": {
          "$ref": "#/$defs/date"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Index into the 1, 3, 7, 21 day intervals."
        }
      }
    }
  }
}
